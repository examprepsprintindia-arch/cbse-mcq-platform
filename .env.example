# Browser-safe frontend runtime configuration. Required for the authentication shell.
# These are public Supabase values, never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Disposable database integration test configuration only.
# Never use a production URL or credentials here; do not commit a populated .env file.
SUPABASE_TEST_DB_URL=

# Optional CLI authentication for an explicitly disposable Supabase test project.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
